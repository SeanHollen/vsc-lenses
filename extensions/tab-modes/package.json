{
  "name": "tabs-per-mode",
  "displayName": "Tabs Per Mode",
  "description": "Maintain separate tab sets for Explorer and Source Control sidebar modes",
  "version": "0.1.0",
  "publisher": "SeanHollen",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "views": {
      "explorer": [
        {
          "id": "tabsPerMode.explorerSentinel",
          "name": "Tabs Per Mode",
          "visibility": "visible"
        }
      ],
      "scm": [
        {
          "id": "tabsPerMode.scmSentinel",
          "name": "Tabs Per Mode",
          "visibility": "visible"
        }
      ]
    },
    "commands": [
      {
        "command": "tabsPerMode.switchToExplorer",
        "title": "Tabs Per Mode: Switch to Explorer Mode"
      },
      {
        "command": "tabsPerMode.switchToSourceControl",
        "title": "Tabs Per Mode: Switch to Source Control Mode"
      },
      {
        "command": "tabsPerMode.focusExplorer",
        "title": "Tabs Per Mode: Open Explorer"
      },
      {
        "command": "tabsPerMode.focusSourceControl",
        "title": "Tabs Per Mode: Open Source Control"
      }
    ],
    "keybindings": [
      {
        "command": "runCommands",
        "args": {
          "commands": [
            "workbench.action.focusSecondEditorGroup",
            "workbench.action.focusFirstEditorGroup",
            "workbench.action.toggleMaximizeEditorGroup",
            "workbench.view.explorer"
          ]
        },
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "config.tabsPerMode.strategy != 'reopen'"
      },
      {
        "command": "runCommands",
        "args": {
          "commands": [
            "workbench.action.focusFirstEditorGroup",
            "workbench.action.focusSecondEditorGroup",
            "workbench.action.toggleMaximizeEditorGroup",
            "workbench.view.scm"
          ]
        },
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "config.tabsPerMode.strategy != 'reopen'"
      },
      {
        "command": "tabsPerMode.focusExplorer",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "config.tabsPerMode.strategy == 'reopen'"
      },
      {
        "command": "tabsPerMode.focusSourceControl",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "config.tabsPerMode.strategy == 'reopen'"
      }
    ],
    "configuration": {
      "title": "Tabs Per Mode",
      "properties": {
        "tabsPerMode.autoNavigate": {
          "type": "boolean",
          "default": true,
          "description": "Auto-open the equivalent file in the target mode when switching (\"reopen\" strategy only)."
        },
        "tabsPerMode.preservePinnedTabs": {
          "type": "boolean",
          "default": true,
          "description": "Keep pinned tabs open regardless of mode (\"reopen\" strategy only)."
        },
        "tabsPerMode.preserveNeutralTabs": {
          "type": "boolean",
          "default": true,
          "description": "Keep non-file tabs (settings, output, etc.) open across mode switches (\"reopen\" strategy only)."
        },
        "tabsPerMode.strategy": {
          "type": "string",
          "enum": [
            "groups",
            "reopen"
          ],
          "default": "groups",
          "enumDescriptions": [
            "Each mode has its own editor group; switching shows the other group instantly (no tabs open or close).",
            "Close the old mode's tabs and reopen the new mode's (original behaviour)."
          ],
          "description": "How mode switches swap tabs. Takes effect after reloading the window."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^25.4.0",
    "@types/vscode": "^1.70.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}